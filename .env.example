# ============================================
# 青岛世天智汇 — 生产环境变量模板
# 使用方式：cp .env.example .env 然后修改 .env 中的值
# ⚠️ .env 文件不进 git，已在 .gitignore 中排除
# ============================================

# --- 数据库 ---
DB_NAME=tsingtaohui
DB_USER=root
DB_PASSWORD=请替换为随机生成的强密码

# --- Redis ---
REDIS_PASSWORD=请替换为随机生成的强密码

# --- JWT ---
# 生成方式：openssl rand -base64 64
JWT_SECRET=请替换为随机生成的64位以上字符串

# --- CORS ---
# 生产环境改为实际域名，多个用逗号分隔
# 示例：https://h5.your-domain.com,https://admin.your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:*

# --- 品牌定制（可选）---
# APP_NAME_ZH=青岛世天智汇
# APP_NAME_EN=Shitian Zhihui
